#nexus
[ Idea: a self-contained NEXUS file. The alignment is embedded in a DATA block,
  and the partitions are defined in a SETS block below. One file holds both, so
  no separate alignment is needed.
  Run with:  iqtree3 -p 08_data_and_partition.nex   (NO -s needed) ]
begin data;
    dimensions ntax=12 nchar=384;
    format datatype=dna missing=? gap=-;
    matrix
        T2        
        T10       
        T3        
        T5        
        T11       
        T6        
        T4        
        T8        
        T12       
        T1        
        T7        
        T9        
    ;
end;

begin sets;
    charset part1 = 1-100;
    charset part2 = 101-384;
    charpartition scheme = HKY+G:part1, GTR+I+G:part2;
end;
